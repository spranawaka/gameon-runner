MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net
MONGODB_DB=gameon_runner
# Host port the game is published on (container always listens on 3000)
APP_PORT=8091

# Email to players after they save (Gmail: use a 16-character App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465            # 465 = SSL. Use 587 if 465 is blocked
SMTP_USER=you@gmail.com
SMTP_PASS=<new 16-character App Password>
EMAIL_FROM="PortCity Run <you@gmail.com>"
